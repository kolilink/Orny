{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@expo/vector-icons": ["node_modules/expo/node_modules/@expo/vector-icons"],
      "@expo/vector-icons/*": ["node_modules/expo/node_modules/@expo/vector-icons/*"],
      "expo-file-system/legacy": ["node_modules/expo-file-system/build/legacy/FileSystem"]
    }
  }
}
